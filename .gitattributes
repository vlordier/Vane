# Default to LF line endings
* text=auto eol=lf

# Explicit text files
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.css text
*.scss text
*.ts text
*.toml text
*.yaml text
*.yml text
*.md text
*.txt text
*.sh text
*.html text
*.sql text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Node modules (shouldn't be tracked)
node_modules/ export-ignore

# Build output
.next/ export-ignore
out/ export-ignore

# OS files
.DS_Store binary
Thumbs.db binary
